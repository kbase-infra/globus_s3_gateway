# Globus Connect Server Configuration
# Copy this file to .env and fill in the values

# Required: Globus identity of the endpoint administrator
# Example: myuser@globusid.org
#GCS_ADMIN_IDENTITY=

# Required: Organization name
# Example: My Organization
#GCS_ORG=

# Required: Contact email for the endpoint
# Example: admin@example.com
#GCS_CONTACT_EMAIL=

# Optional: Display name for the endpoint
# Default: Globus Connect Server
#GCS_DISPLAY_NAME=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# Default: INFO
#GCS_LOG_LEVEL=INFO

# Optional: Override the Docker image to use
# If not set, the image will be built from the local Dockerfile
# Example: ghcr.io/kbase-infra/globus_s3_gateway/globus-connect-server:latest
#GCS_IMAGE=
